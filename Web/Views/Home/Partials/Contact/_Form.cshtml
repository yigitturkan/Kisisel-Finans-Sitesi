<div class="col-lg-7">

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">Mesaj Gönder</h4>

            <form>

                <div class="mb-3">
                    <label class="form-label">Ad Soyad</label>
                    <input type="text" class="form-control" placeholder="Adınızı giriniz">
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="Email adresiniz">
                </div>

                <div class="mb-3">
                    <label class="form-label">Mesaj</label>
                    <textarea class="form-control" rows="5" placeholder="Mesajınızı yazın"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Mesaj Gönder
                </button>

            </form>

        </div>
    </div>

</div>