@model IEnumerable<Core.Concrete.Entities.Income>

@{
    ViewBag.Title = "Gelirlerim";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Gelir Listesi</h5>

            <a href="@Url.Action("AddIncome", "Transaction")"
               class="btn btn-primary btn-sm">
                Yeni Gelir Ekle
            </a>
        </div>

        <div class="table-responsive text-nowrap">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Kategori</th>
                        <th>Kaynak</th>
                        <th>Açıklama</th>
                        <th>Miktar</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody class="table-border-bottom-0">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Kategori -->
                                <td>
                                    <span class="badge bg-label-success">
                                        @item.Category
                                    </span>
                                </td>

                                <!-- Kaynak -->
                                <td>
                                    @item.Source
                                </td>

                                <!-- Açıklama -->
                                <td>
                                    <strong>@item.Description</strong>
                                </td>

                                <!-- Miktar -->
                                <td class="text-success fw-bold">
                                    ₺@item.Amount.ToString("N2")
                                </td>

                                <!-- Tarih -->
                                <td>
                                    @item.CreatedDate.ToString("dd.MM.yyyy")
                                </td>

                                <!-- İşlemler -->
                                <td>

                                    <a href="@Url.Action("DeleteIncome", "Transaction", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Bu gelir silinsin mi?')">

                                        Sil

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">
                                Henüz bir gelir kaydı bulunamadı.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>