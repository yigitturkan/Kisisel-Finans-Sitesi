@model Core.Concrete.Entities.Income

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.Title = "Gelir Ekle";
}

<div class="container-xxl container-p-y">
    <div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bx bxs-plus-circle"></i> Yeni Gelir Ekle
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bx bxs-check-circle"></i> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("AddIncome", "Transaction", FormMethod.Post, new { novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label class="form-label" for="Amount">Tutar <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", @type = "number", @step = "0.01", @min = "0.01", @placeholder = "0.00", @required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="Source">Gelir Kaynağı <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Source, new { @class = "form-control", @placeholder = "Örn: Maaş, Bonus, Yatırım Getirileri", @required = "required" })
                            @Html.ValidationMessageFor(m => m.Source, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="Category">Kategori <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Category, new SelectList(new List<string>
                                        {
                                "Maaş",
                                "Serbest Çalışma",
                                "Yatırım Getirisi",
                                "Kira Geliri",
                                "Bonus",
                                "Hediye",
                                "Diğer"
                            }), "-- Kategori Seçin --", new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="Description">Açıklama</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @rows = "4", @placeholder = "Örn: Aylık maaş, İlave gelir vb." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-0">
                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="bx bx-save"></i> Geliri Kaydet
                            </button>
                        </div>
                    }

                    <div class="mt-3">
                        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-secondary w-100">
                            <i class="bx bx-arrow-back"></i> Dashboard'a Dön
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bilgi Kutusu -->
            <div class="alert alert-info mt-4" role="alert">
                <h6 class="alert-heading">
                    <i class="bx bxs-info-circle"></i> İpuçları
                </h6>
                <ul class="mb-0">
                    <li>Gelir kaynağını açık ve anlaşılır şekilde belirtin</li>
                    <li>Tutarı doğru girin - Türk Lirası (₺) cinsinden</li>
                    <li>Açıklamaya ek bilgi ekleyerek takip kolaylığı sağlayın</li>
                    <li>Kaydedilen geliriniz dashboard'da gösterilecektir</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .input-group-text {
        border-color: #28a745 !important;
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25) !important;
    }

    .card {
        border-radius: 10px !important;
    }

    .btn {
        border-radius: 8px !important;
        font-weight: 500 !important;
        transition: all 0.3s ease !important;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

    label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }
</style>
