@model IEnumerable<Core.Concrete.Entities.Expense>

@{
    ViewBag.Title = "Giderlerim";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="card border-danger">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Gider Listesi</h5>

            <a href="@Url.Action("AddExpense", "Transaction")"
               class="btn btn-danger btn-sm">
                Yeni Gider Ekle
            </a>
        </div>

        <div class="table-responsive text-nowrap">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Açıklama</th>
                        <th>Miktar</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Açıklama -->
                                <td>
                                    @item.Description
                                </td>

                                <!-- Miktar -->
                                <td class="text-danger fw-bold">
                                    ₺@item.Amount.ToString("N2")
                                </td>

                                <!-- Tarih -->
                                <td>
                                    @item.CreatedDate.ToString("dd.MM.yyyy")
                                </td>

                                <!-- İşlemler -->
                                <td>

                                    <a href="@Url.Action("DeleteExpense", "Transaction", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Bu gider silinsin mi?')">
                                        Sil
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Henüz bir gider kaydı bulunamadı.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>