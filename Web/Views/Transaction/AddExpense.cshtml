@model Core.Concrete.Entities.Expense

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.Title = "Gider Ekle";
}

<div class="container-xxl container-p-y">
    <div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bx bxs-plus-circle"></i> Yeni Gider Ekle
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bx bxs-check-circle"></i> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("AddExpense", "Transaction", FormMethod.Post, new { novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label class="form-label" for="Amount">Tutar <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", @type = "number", @step = "0.01", @min = "0.01", @placeholder = "0.00", @required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="Category">Kategori <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Category, new SelectList(new List<string>
                            {
                                "Yiyecek & İçecek",
                                "Ulaşım",
                                "Eğlence",
                                "Sağlık",
                                "Eğitim",
                                "Kira",
                                "Faturalar",
                                "Diğer"
                            }), "-- Kategori Seçin --", new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="Description">Açıklama</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @rows = "4", @placeholder = "Örn: Haftalık alışverişler, Benzin, Sinema vb." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-0">
                            <button type="submit" class="btn btn-danger btn-lg w-100">
                                <i class="bx bx-save"></i> Gideri Kaydet
                            </button>
                        </div>
                    }

                    <div class="mt-3">
                        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-secondary w-100">
                            <i class="bx bx-arrow-back"></i> Dashboard'a Dön
                        </a>
                    </div>
                </div>
            </div>

            <!-- Gider Kategorileri -->
            <div class="card mt-4 border-0 shadow-sm">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0">
                        <i class="bx bx-list-check"></i> Gider Kategorileri
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <div class="category-badge p-2 rounded">
                                <i class="bx bxs-food" style="font-size: 24px; color: #ff9800;"></i>
                                <p class="mb-0 mt-2" style="font-size: 12px;">Yiyecek & İçecek</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="category-badge p-2 rounded">
                                <i class="bx bxs-car" style="font-size: 24px; color: #2196f3;"></i>
                                <p class="mb-0 mt-2" style="font-size: 12px;">Ulaşım</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="category-badge p-2 rounded">
                                <i class="bx bxs-smile" style="font-size: 24px; color: #f44336;"></i>
                                <p class="mb-0 mt-2" style="font-size: 12px;">Eğlence</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="category-badge p-2 rounded">
                                <i class="bx bxs-heart" style="font-size: 24px; color: #e91e63;"></i>
                                <p class="mb-0 mt-2" style="font-size: 12px;">Sağlık</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="category-badge p-2 rounded">
                                <i class="bx bxs-book" style="font-size: 24px; color: #9c27b0;"></i>
                                <p class="mb-0 mt-2" style="font-size: 12px;">Eğitim</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="category-badge p-2 rounded">
                                <i class="bx bxs-home" style="font-size: 24px; color: #8bc34a;"></i>
                                <p class="mb-0 mt-2" style="font-size: 12px;">Kira</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- İpuçları -->
            <div class="alert alert-info mt-4" role="alert">
                <h6 class="alert-heading">
                    <i class="bx bxs-info-circle"></i> İpuçları
                </h6>
                <ul class="mb-0">
                    <li>Uygun kategoriyi seçerek giderlerinizi organize edin</li>
                    <li>Tutarı doğru girin - Türk Lirası (₺) cinsinden</li>
                    <li>Detaylı açıklama ekleyerek sonradan takip kolaylığı sağlayın</li>
                    <li>Kaydedilen giderleriniz dashboard'da gösterilecektir</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .input-group-text, .form-select:focus {
        border-color: #dc3545 !important;
    }

    .form-control:focus, .form-select:focus {
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }

    .card {
        border-radius: 10px !important;
    }

    .btn {
        border-radius: 8px !important;
        font-weight: 500 !important;
        transition: all 0.3s ease !important;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .category-badge {
        background-color: #f5f5f5;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .category-badge:hover {
        background-color: #e8e8e8;
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .form-select {
        border-radius: 6px !important;
    }
</style>
