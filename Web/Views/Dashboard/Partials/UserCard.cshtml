
<div class="col-12">
    <div class="card text-white border-0 shadow-lg rounded-4 bg-primary bg-gradient">
        <div class="card-body p-4">

            <div class="d-flex align-items-center">

                <div>
                    <span class="badge bg-light text-dark mb-2">
                        Özet Panel
                    </span>

                    <h4 class="fw-bold mb-1">
                        Hoş geldin, @(ViewBag.UserName ?? "Kullanıcı")
                    </h4>

                    <p class="mb-0 opacity-75">
                        Bugünkü finansal verilerin güncellenmiş durumunu aşağıda görüntüleyebilirsin.
                    </p>
                </div>

                <div class="ms-auto d-none d-md-block">
                    <i class="bx bxs-pie-chart-alt-2 fs-1 opacity-50"></i>
                </div>

            </div>

        </div>
    </div>
</div>